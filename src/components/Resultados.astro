---
import Octopus from './Octopus.astro';
---

<section id="tentaculos" class="relative py-28 sm:py-36">
  <div class="contenedor">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm tracking-[0.3em] text-espuma/70 uppercase" data-revelar>Ocho tentáculos, ocho libros</p>
      <h2 class="mt-3 font-display text-4xl leading-tight text-white sm:text-6xl" data-res-titulo data-revelar>
        El pulpo te espera en el fondo
      </h2>
      <p class="mt-4 text-espuma/75" data-res-bajada data-revelar>
        Completá la inmersión y va a desplegar sus tentáculos con una recomendación en cada uno.
      </p>
    </div>

    <div class="mt-16 grid items-start gap-6 xl:grid-cols-[1fr_minmax(240px,340px)_1fr] xl:gap-8">
      <ul class="order-2 grid gap-4 sm:grid-cols-2 xl:order-1 xl:grid-cols-1" data-res-col="izq"></ul>

      <div class="order-1 mx-auto w-[min(70vw,320px)] xl:sticky xl:top-24 xl:order-2 xl:w-full" data-res-pulpo>
        <Octopus especie="comun" biolum label="Tu pulpo guía" />
        <div class="mt-4 hidden text-center" data-res-especie>
          <p class="text-xs tracking-[0.25em] text-naranja uppercase">Tu guía</p>
          <p class="font-display text-3xl text-white" data-res-especie-nombre></p>
          <p class="font-display text-espuma/60 italic" data-res-especie-cientifico></p>
          <p class="mt-2 text-sm text-espuma/70" data-res-especie-zona></p>
        </div>
      </div>

      <ul class="order-3 grid gap-4 sm:grid-cols-2 xl:grid-cols-1" data-res-col="der"></ul>
    </div>

    <div class="mt-16 hidden justify-center gap-3" data-res-acciones>
      <a href="#inmersion" class="boton" data-scroll data-reiniciar>Volver a sumergirme</a>
      <a href="#oceanos" class="boton-sec" data-scroll>Ver los océanos</a>
    </div>
  </div>
</section>

<template id="tpl-libro">
  <li class="libro-card group relative flex gap-4 rounded-2xl border border-white/10 bg-white/[0.05] p-4 backdrop-blur-md">
    <div
      class="portada relative flex h-36 w-24 shrink-0 flex-col justify-between overflow-hidden rounded-md p-2 shadow-lg shadow-black/40"
      data-portada
    >
      <span class="text-[9px] tracking-widest uppercase opacity-70" data-portada-oceano></span>
      <span class="font-display text-sm leading-tight font-bold" data-portada-titulo></span>
      <span class="text-[9px] opacity-80" data-portada-autor></span>
    </div>
    <div class="min-w-0">
      <p class="text-[10px] tracking-[0.2em] text-espuma/50 uppercase" data-tentaculo></p>
      <h3 class="mt-1 font-display text-xl leading-tight text-white" data-titulo></h3>
      <p class="text-sm text-espuma/70" data-autor></p>
      <div class="mt-2 flex flex-wrap gap-1.5 text-[11px]">
        <span class="rounded-full border px-2 py-0.5" data-chip-oceano></span>
        <span class="rounded-full border border-white/20 px-2 py-0.5 text-espuma/80" data-chip-zona></span>
        <span class="rounded-full bg-naranja/20 px-2 py-0.5 text-naranja" data-chip-motivo></span>
      </div>
      <p class="mt-2 text-sm text-espuma/80" data-resena></p>
      <div class="mt-3 flex flex-wrap gap-2 text-xs">
        <a class="tienda" target="_blank" rel="noopener noreferrer" data-tienda="amazon">Buscar en Amazon ↗</a>
        <a class="tienda" target="_blank" rel="noopener noreferrer" data-tienda="buscalibre">Buscar en Buscalibre ↗</a>
      </div>
    </div>
  </li>
</template>
